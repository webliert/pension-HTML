# ================================================
# Supabase 环境变量
# ================================================
# 1. 复制本文件为 .env.local：
#    cp .env.example .env.local
# 2. 在 Supabase 控制台获取下面两个值：
#    - Project URL:        Settings → API → Project URL
#    - Publishable key:    Settings → API → Publishable key
#      （2024+ 新版项目以 sb_publishable_ 开头；老项目仍是 eyJ 开头的 anon JWT）
# 3. 把下面的占位替换为真实值后，重新运行 npm run build
#    （NEXT_PUBLIC_* 变量会被打包进静态文件，必须构建时存在）
#
# 兼容性说明：代码会优先读取 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY，
# 找不到时自动 fallback 到 NEXT_PUBLIC_SUPABASE_ANON_KEY（老项目兼容）。
# ================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# 老项目可使用（2024 年之前的 Supabase 项目，签发的是 eyJ 开头的 JWT）
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-jwt-here